---
/** Blog post page. Only published posts (`draft: false`) are generated. */
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Lang } from '../../../i18n/ui';
import { localePath, supportedLangs, useTranslations } from '../../../i18n/utils';
import { getPublishedPosts } from '../../../lib/blog';
import { splitLocaleId } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of supportedLangs) {
    for (const post of await getPublishedPosts(lang)) {
      const parts = splitLocaleId(post.id);
      if (parts) paths.push({ params: { lang, slug: parts.slug }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(post);
const otherLang = supportedLangs.find((l) => l !== lang) ?? lang;
const dateFormat = new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  showBlog
  current="blog"
  langSwitchHref={localePath(otherLang)}
  alternates={false}
>
  <article class="section page-top">
    <div class="container prose">
      <p><a href={localePath(lang, 'blog/')}>← {t.blog.back}</a></p>
      <header>
        <span class="section-label" aria-hidden="true">// blog</span>
        <h1 class="section-title">{post.data.title}</h1>
        <p class="cert-date">
          {t.blog.publishedOn} <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
        </p>
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => (
                <li class="tech-tag">{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      <Content />
    </div>
  </article>
</BaseLayout>
